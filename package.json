{
  "name": "dsh-better",
  "description": "Better DSH: archived-session management and task-stop desktop notifications for the dsh web GUI",
  "version": "0.1.0",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh"
  ],
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
